# Idea Flow — environment template
#
# Dev and prod use different values for the same variables. Use profiles.
#
#   dev :  cp .env.example .env        (docker compose --profile dev ...)
#   prod:  cp .env.example .env.prod   (docker compose --profile prod ...)
#
# Both files are git-ignored and must never be committed. The file passed with
# `--env-file` is used BOTH for compose interpolation (${VAR}) and, for the api
# service, injected into the container through `env_file`.
#
# ===========================================================================
# DEV vs PROD
# ===========================================================================
# Dev uses profile dev (services: postgres, api, web). Ports: 5173/3000/5432.
# Prod uses profile prod (services: postgres-prod, api-prod, web-prod). Port: 8080 only.
# In prod, API and Postgres are not published to host (only exposed internally).

# ===========================================================================
# PROD ONLY — values that must differ from dev defaults
# ===========================================================================
# POSTGRES_PASSWORD=<long random string>
# DATABASE_URL=postgres://postgres:<url-encoded-password>@postgres:5432/idea_flow
# PROD_WEB_PORT=8080
# VITE_API_URL=/api
# PUBLIC_URL=https://<your-domain>

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD='change-me-locally'
POSTGRES_DB=idea_flow

# Connection string used by the api. Inside the Docker network host is 'postgres'.
# IMPORTANT: URL-encode password if it contains special chars. If your password
# contains '$', escape as '$$' (Compose interpolation). See note below.
DATABASE_URL=postgres://postgres:change-me-locally@postgres:5432/idea_flow

# ##########################################################################
# # READ THIS BEFORE CHOOSING A PASSWORD                                   #
# #                                                                        #
# # Compose applies variable interpolation to this file. A bare `$` is an   #
# # interpolation marker and values may be silently truncated at the first  #
# # `$`. Use single quotes (or `$$`) for values containing `$`.            #
# # Example: openssl rand -base64 24 may contain `$` -> use `$$` or quotes.#
# #                                                                        #
# #   POSTGRES_PASSWORD='aB3$xY9'  (single quotes protect in many shells)  #
# #   POSTGRES_PASSWORD=aB3$$xY9   (double `$` becomes literal `$`)        #
# # ##########################################################################

# Where the production database lives on the host (prod only)
# POSTGRES_DATA_PATH=./infra/postgres/data

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
WEB_PORT=5173
API_PORT=3000
PROD_WEB_PORT=8080

# Origin allowed to call api in dev (Vite). Ignored in prod (same-origin).
CORS_ORIGIN=http://localhost:5173

# Absolute base URL of the api as seen by browser
VITE_API_URL=http://localhost:3000

# Optional: force graph path prefix for web (read by apps/web/src/lib/api.ts)
VITE_GRAPH_PATH=

# Public entrypoint (prod only, used as CORS_ORIGIN fallback)
# PUBLIC_URL=https://idea-flow.example.com

# ---------------------------------------------------------------------------
# Images (prod only)
# ---------------------------------------------------------------------------
# API_IMAGE=idea-flow/api:local
# WEB_IMAGE=idea-flow/web:local

# ---------------------------------------------------------------------------
# Development settings
# ---------------------------------------------------------------------------
WATCH_POLLING=true
APP_ENV_FILE=.env

# ---------------------------------------------------------------------------
# Postgres init args
# ---------------------------------------------------------------------------
POSTGRES_INITDB_ARGS=--data-checksums

# ---------------------------------------------------------------------------
# Application secrets (injected via env_file; never committed)
# ---------------------------------------------------------------------------
