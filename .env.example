# Idea Flow — environment template
#
# One dotenv file PER ENVIRONMENT, because dev and prod need different values
# for the same variables (Vite on 5173 vs the static server on 8080, absolute
# api URL vs proxied relative URL).
#
#   dev :  cp .env.example .env
#   prod:  cp .env.example .env.prod    (then apply the PROD section below)
#
# Both files are git-ignored and must never be committed. The file passed with
# `--env-file` is used BOTH for compose interpolation (${VAR}) and, for the api
# service, injected into the container through `env_file`.
#
# In production every secret below is mandatory: compose aborts with
# ${VAR:?...} if one is missing, so a half-filled file can never reach prod.

# ===========================================================================
# PROD ONLY — the four values that must differ from the dev defaults
# ===========================================================================
# POSTGRES_PASSWORD=<a long random string, NOT this one>
# DATABASE_URL=postgres://postgres:<same-url-encoded-password>@postgres:5432/idea_flow
# WEB_PORT=8080
# VITE_API_URL=/api
# PUBLIC_URL=https://<your-domain>

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Host port. Always bound to 127.0.0.1, never reachable from the network.
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=idea_flow

# Connection string used by the api. Inside the Docker network the host is
# always the service name `postgres`, never `localhost`.
#
# IMPORTANT: URL-encode the password if it contains any of
#   @ : / ? # [ ] %      (use %40 %3A %2F %3F %23 %5B %5D %25)
DATABASE_URL=postgres://postgres:change-me-locally@postgres:5432/idea_flow

# ##########################################################################
# # READ THIS BEFORE CHOOSING A PASSWORD                                   #
# #                                                                        #
# # Compose applies variable interpolation to this file, and a bare `$` is  #
# # an interpolation marker. A password is therefore SILENTLY TRUNCATED at #
# # the first `$` — no error, the stack just starts and then fails to       #
# # authenticate:                                                         #
# #                                                                        #
# #   POSTGRES_PASSWORD=aB3$xY9   ->  resolves to "aB3"   BROKEN, silent   #
# #   POSTGRES_PASSWORD="aB3$xY9" ->  resolves to "aB3"   BROKEN, silent   #
# #   POSTGRES_PASSWORD='aB3$xY9' ->  resolves to "aB3$xY9"   correct      #
# #   POSTGRES_PASSWORD=aB3$$xY9  ->  resolves to "aB3$xY9"   correct      #
# #                                                                        #
# # Use single quotes (or `$$`) for any value that may contain `$`.         #
# # Generated passwords from openssl almost always contain `$`.             #
# #   openssl rand -base64 24 | tr -d '\n'                                 #
# # ##########################################################################


# Where the production database lives on the host. Prod only; it makes
# backup/restore a plain file copy instead of a `docker volume` dance.
# POSTGRES_DATA_PATH=./infra/postgres/data

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
# dev : Vite dev server -> http://localhost:5173
# prod: static server  -> http://localhost:8080
WEB_PORT=5173
API_PORT=3000

# Origin allowed to call the api in dev (the Vite server). Ignored in prod,
# where the browser calls /api on the same origin and nginx proxies it.
CORS_ORIGIN=http://localhost:5173

# Absolute base URL of the api as seen by the BROWSER.
#   dev  -> the api is published on host port 3000, so an absolute URL is used
#           and the api must be CORS-enabled (see CORS_ORIGIN above).
#   prod -> web proxies /api to the api on the same origin, so a relative path
#           is used and no CORS is involved.
# If you prefer a Vite dev proxy instead, set VITE_API_URL=/api and add the
# matching `server.proxy` entry to the web dev config.
VITE_API_URL=http://localhost:3000

# Public entrypoint of the app, prod only (used as the CORS_ORIGIN fallback).
# PUBLIC_URL=https://idea-flow.example.com

# ---------------------------------------------------------------------------
# Images (prod only) — point these at a CI artifact to deploy without editing
# any compose file
# ---------------------------------------------------------------------------
# API_IMAGE=idea-flow/api:local
# WEB_IMAGE=idea-flow/web:local

# ---------------------------------------------------------------------------
# Application secrets
# ---------------------------------------------------------------------------
# Injected into the api container through `env_file`. Never committed.
# JWT_SECRET=
# API_TOKEN=
