# Idea Flow — environment template
#
#   cp .env.example .env        then: docker compose up -d
#
# The file is git-ignored and must never be committed. It is used BOTH for
# compose interpolation (${VAR}) and, for the api service, injected into the
# container through `env_file`.

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD='change-me-locally'
POSTGRES_DB=idea_flow

# Connection string used by the api. Inside the Docker network the host is
# always the service name `postgres`, never `localhost`.
#
# IMPORTANT: URL-encode the password if it contains any of
#   @ : / ? # [ ] %      (use %40 %3A %2F %3F %23 %5B %5D %25)
DATABASE_URL=postgres://postgres:change-me-locally@postgres:5432/idea_flow

# ##########################################################################
# # READ THIS BEFORE CHOOSING A PASSWORD                                   #
# #                                                                        #
# # Compose applies variable interpolation to this file. A bare `$` is an   #
# # interpolation marker and values may be silently truncated at the first  #
# # `$`. Use single quotes (or `$$`) for values containing `$`.            #
# # Example: openssl rand -base64 24 may contain `$` -> use `$$` or quotes.#
# #                                                                        #
# #   POSTGRES_PASSWORD='aB3$xY9'  (single quotes protect in many shells)  #
# #   POSTGRES_PASSWORD=aB3$$xY9   (double `$` becomes literal `$`)        #
# # ##########################################################################

# ---------------------------------------------------------------------------
# Published ports (all bound to 127.0.0.1, never the LAN)
# ---------------------------------------------------------------------------
WEB_PORT=5173
API_PORT=3000

# Origin allowed to call the api (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Absolute base URL of the api as seen by the browser. The web container reads
# it through `env_file`; the default works with zero extra frontend config.
VITE_API_URL=http://localhost:3000

# Optional: force the graph path prefix for the web app (read by
# apps/web/src/lib/api.ts).
VITE_GRAPH_PATH=

# ---------------------------------------------------------------------------
# Development settings
# ---------------------------------------------------------------------------
WATCH_POLLING=true
APP_ENV_FILE=.env

# ---------------------------------------------------------------------------
# Postgres init args
# ---------------------------------------------------------------------------
POSTGRES_INITDB_ARGS=--data-checksums

# ---------------------------------------------------------------------------
# Application secrets (injected via env_file; never committed)
# ---------------------------------------------------------------------------
